/**
 * Wrangler configuration for the Webhook Dashboard.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webhook",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets served via Workers Assets (React SPA)
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "routes": [
    {
      "pattern": "webhook.msar.dev",
      "zone_name": "msar.dev",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
   ],

  // D1 SQLite database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webhook",
      // Replace with real ID after: npx wrangler d1 create webhook_db
      "database_id": "646d0072-2a59-47c3-be95-1eb6c399d746",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true
}
