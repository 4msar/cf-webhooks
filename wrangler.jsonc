/**
 * Wrangler configuration for the Webhook Dashboard.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webhook",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets served via Workers Assets (React SPA)
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // D1 SQLite database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webhook_db",
      // Replace with real ID after: npx wrangler d1 create webhook_db
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true
}
